{
  "name": "@altmanlib/durable-infra",
  "version": "0.11.0",
  "description": "Shared infrastructure for pi-durable chat bots: sessions, settings, the business database and optional feature modules",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures",
    "!src/architecture.ts",
    "!src/probe-durable.ts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altmanlib/durable-infra.git"
  },
  "homepage": "https://github.com/altmanlib/durable-infra#readme",
  "bugs": {
    "url": "https://github.com/altmanlib/durable-infra/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/kernel/index.ts",
    "./platform": "./src/platform/index.ts",
    "./platform/records": "./src/platform/records/index.ts",
    "./modules/clock": "./src/modules/clock/index.ts",
    "./modules/reminder": "./src/modules/reminder/index.ts",
    "./modules/web": "./src/modules/web/index.ts",
    "./modules/memo": "./src/modules/memo/index.ts",
    "./modules/settings-tools": "./src/modules/settings-tools/index.ts",
    "./modules/gitea": "./src/modules/gitea/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "biome check --write .",
    "typecheck": "bun check",
    "probe": "bun run src/probe-durable.ts",
    "test": "bun test",
    "verify": "biome check . && bun check && bun test",
    "check:package": "publint",
    "release": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "kysely": "^0.29.6"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@types/bun": "^1.4.3",
    "kysely": "^0.29.7",
    "publint": "^0.3.25",
    "typescript": "^6"
  }
}
